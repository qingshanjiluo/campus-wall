# CampusWall 生产环境变量模板 — 复制为 .env 并全部改掉默认值！
# docker compose 会自动读取同目录 .env

# ── 必改：密钥（生成长随机串）──
# openssl rand -hex 32
JWT_SECRET=
SECRET_KEY=

# ── 站点对外地址（HTTPS 配好后改成 https://你的域名；用于找回密码邮件链接）──
SITE_BASE_URL=http://your-domain-or-ip

# ── CORS：生产改为你的域名（逗号分隔多个），默认 * 仅限起步 ──
# CORS_ORIGINS=https://campus.example.edu

# ── 找回密码邮件（可选；不配 SMTP_HOST 则重置接口走开发模式）──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_TLS=1
