# 生产环境变量模板
# 复制为 .env 或 export 到 shell，然后启动 gunicorn

# 安全（必填）
JWT_SECRET=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-another-long-random-string

# 环境
FLASK_ENV=production
PORT=5000

# 站点地址（用于找回密码链接等）
SITE_BASE_URL=https://campuswall.example.com

# 邮件（可选，用于找回密码；不配置则开发模式回显 token）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_TLS=1
