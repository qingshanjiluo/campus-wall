# ── kungal API (apps/api) runtime env ──────────────────────────────────────
# Copy to docker/api.env and fill the blanks. Read at RUNTIME via env_file;
# never baked into the image, never committed (docker/*.env is gitignored).
#
# Hostnames are CONTAINER service names, not host ports. They resolve on
# kun-galgame-infra's shared network (postgres / redis / oauth / image / wiki),
# which kungal's docker-compose.yml joins — so bring infra up first.

# Server
SERVER_PORT=2334
SERVER_MODE=prod

# Database — kungal's own DB (kungalgame) on infra's shared Postgres.
# Set the password to match infra's Postgres (local default 191007); real creds in prod.
KUN_DATABASE_URL=postgresql://postgres:kungal_dev_pw@postgres:5432/kungalgame
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OAuth (source of truth for identity + moemoepoint)
OAUTH_SERVER_URL=http://oauth:9277/api/v1
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://www.kungal.com/auth/callback
JWT_SECRET=

# File storage (toolset archive uploads — Backblaze B2 in prod). The only
# S3-API bucket the forum uses — inline / content images all go through
# image_service (KUN_IMAGE_CLIENT_*), not a local bucket. Leave empty to
# disable toolset uploads entirely.
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_REGION=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Search (Meilisearch)
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=

# NextMoe catalog galgame surface (prod catalog :9281; HOST base, no /api
# suffix). Reads → {base}/internal + X-API-Key; writes/admin/feeds → {base}/api.
KUN_NEXTMOE_API_BASE=http://catalog:9281
# internal-tier devapi key (X-API-Key) for the read face. Empty → reads fall
# back to the legacy /api face (rollback valve). Do NOT commit a real key.
KUN_NEXTMOE_API_KEY=

# image_service — public CDN prefix. MUST equal infra's KUN_IMAGE_PUBLIC_BASE_URL
# (the shared image_service domain), no trailing slash.
KUN_IMAGE_PUBLIC_BASE_URL=https://image.kungal.iloveren.link

# image_service — client credentials for direct galgame-cover uploads. Set
# both to enable /image/galgame; leave empty for a clear "未配置" error.
KUN_IMAGE_CLIENT_BASE_URL=http://image:9278
KUN_IMAGE_CLIENT_ID=
KUN_IMAGE_CLIENT_SECRET=

# community service (dev stack community :9282) — the UNCONDITIONAL backend for
# the galgame + resource comment areas over S2S (legacy in-forum comment routes
# retired). ClientID/Secret intentionally left empty → fall back to OAUTH_CLIENT_*.
# Unset base URL = comments degrade (reads empty / writes 503).
KUN_COMMUNITY_API_BASE=http://community:9282/api/v1/community
